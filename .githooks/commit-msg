#!/bin/sh
# drugref's commit-msg hook (issue 118): refuse a message that closes an issue by
# accident. Installed with `git config core.hooksPath .githooks` -- see
# docs/PROJECT-NOTES.md § "How to run / test".
#
# WHY THE RULE IS IN PYTHON AND ONLY THE DISPATCH IS HERE: the check is pinned by
# `tests/test_commit_lint.py`, against the commit bodies that actually closed an issue
# nobody meant to close. A rule written in `sh` would be a second copy with nothing
# testing it.
#
# TWO INTERPRETERS, AND THE ORDER MATTERS. `uv run` gets the project's own environment;
# a bare `python3` is the fallback for a checkout where uv is not on the hook's PATH,
# which is the ordinary case for GUI git clients (VS Code, Tower, GitHub Desktop) and
# many CI images. `drugref.commit_lint` imports only the standard library and carries
# `from __future__ import annotations` so that fallback runs on the Python the OS ships.
#
# ⇒ EXIT STATUS IS TRIAGED, NOT FORWARDED BLINDLY, and this is the part that keeps the
# guard installable. `commit_lint` answers 0 (allow) or 1 (reject) and nothing else, so
# any OTHER status is uv failing for an environment reason -- an unsynced project, a
# stale lock, no network -- which has nothing to do with the commit message. Forwarding
# it would reject a perfectly good commit and teach the author to reach for
# `--no-verify`, which is how a guard gets uninstalled. Those statuses fall through to
# the fallback interpreter instead, and say so.
#
# NO `set -e`: every failure here needs its status inspected rather than acted on, and
# `set -e` would exit on the very command whose non-zero status is the thing to triage.
# $0 is this script, so the path is resolved relative to the hook rather than to the cwd
# git happens to run it from.
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd) || exit 1

if command -v uv >/dev/null 2>&1; then
    uv run --quiet --project "$root" python -m drugref.commit_lint "$1"
    status=$?
    if [ "$status" -le 1 ]; then
        exit "$status"
    fi
    echo "drugref: uv could not run the commit guard (exit $status); falling back to" \
         "python3 so the guard still runs" >&2
fi

PYTHONPATH="$root/src${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m drugref.commit_lint "$1"
