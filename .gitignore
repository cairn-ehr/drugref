dist/
*.egg-info/
downloads/

# Reviewer desktop build output and installed dependencies.
node_modules/
target/
/reviewer-domain/Cargo.lock
.svelte-kit/

# Real MED-RT / MeSH release files: large, fetched per docs/HANDOVER.md, never
# committed. downloads/ is their intended home; these guard against an accidental
# drop in the repo root (supp2026 alone is 750 MB uncompressed). Fixtures live in
# tests/fixtures/ under their own mesh_*_subset.xml / medrt_subset.xml names.
desc2026
supp2026
desc2026.xml
supp2026.xml
pa2026.xml
desc2026.gz
supp2026.gz
Core_MEDRT_*.xml

# MkDocs build output for the docs-site/ project (a CI artifact, never committed).
docs-site/site/

# Coding-agent scratch: per-plan ledgers, task briefs and review packages written
# while a plan is being executed. Disposable by design -- git history is the record.
.superpowers/

# Editor and mutation-testing backups. `commit-push` stages everything, and a
# `.bak` beside an applied migration is one `git add -A` from being committed.
*.bak
*.orig
